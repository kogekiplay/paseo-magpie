{
  "name": "paseo-magpie",
  "version": "0.9.1",
  "description": "Track Magpie quotas, inspect actual routes, and compare provider latency and TPS trends in Paseo.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kogekiplay/paseo-magpie.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.server.ts",
    "index.client.tsx",
    "client/",
    "!client/*.test.ts",
    "shared/",
    "server/",
    "!server/*.test.ts",
    "assets/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.ts client/*.test.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.16.0",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
